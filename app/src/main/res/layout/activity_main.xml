<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#E9E3D7">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FOREST ZEN" android:textColor="#243421" android:textSize="32sp"
            android:textStyle="bold" android:letterSpacing="0.08"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="One UI ana ekranın kalsın. Tema parçalarını buradan uygula."
            android:textColor="#52604C" android:textSize="16sp"
            android:layout_marginTop="6dp" android:layout_marginBottom="18dp"/>

        <ImageView android:id="@+id/preview" android:layout_width="match_parent"
            android:layout_height="320dp" android:scaleType="centerCrop"
            android:background="@drawable/card" android:contentDescription="Forest Zen wallpaper preview"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Duvar kağıdı" android:textColor="#243421" android:textStyle="bold"
            android:textSize="20sp" android:layout_marginTop="22dp"/>

        <Button android:id="@+id/homeWallpaper" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Ana ekrana uygula"
            android:textColor="#F6F0E5" android:background="@drawable/button_primary"
            android:layout_marginTop="10dp"/>

        <Button android:id="@+id/lockWallpaper" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Kilit ekranına uygula"
            android:textColor="#F6F0E5" android:background="@drawable/button_primary"
            android:layout_marginTop="10dp"/>

        <Button android:id="@+id/bothWallpaper" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="İkisine birden uygula"
            android:textColor="#F6F0E5" android:background="@drawable/button_primary"
            android:layout_marginTop="10dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Widget'lar" android:textColor="#243421" android:textStyle="bold"
            android:textSize="20sp" android:layout_marginTop="24dp"/>

        <Button android:id="@+id/addClock" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Forest Zen saat widget'ı ekle"
            android:textColor="#243421" android:background="@drawable/button_secondary"
            android:layout_marginTop="10dp"/>

        <Button android:id="@+id/addQuote" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Forest Zen söz widget'ı ekle"
            android:textColor="#243421" android:background="@drawable/button_secondary"
            android:layout_marginTop="10dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="İkonlar" android:textColor="#243421" android:textStyle="bold"
            android:textSize="20sp" android:layout_marginTop="24dp"/>

        <Button android:id="@+id/openThemePark" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Theme Park'ı aç → Icons → Iconpack"
            android:textColor="#F6F0E5" android:background="@drawable/button_primary"
            android:layout_marginTop="10dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sistem görünümü" android:textColor="#243421" android:textStyle="bold"
            android:textSize="20sp" android:layout_marginTop="24dp"/>

        <Button android:id="@+id/openFont" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Yazı tipi ayarlarını aç"
            android:textColor="#243421" android:background="@drawable/button_secondary"
            android:layout_marginTop="10dp"/>

        <Button android:id="@+id/openLockSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Kilit ekranı ayarlarını aç"
            android:textColor="#243421" android:background="@drawable/button_secondary"
            android:layout_marginTop="10dp" android:layout_marginBottom="26dp"/>
    </LinearLayout>
</ScrollView>
